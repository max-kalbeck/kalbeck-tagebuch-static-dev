venv=venv
currentvenv=""
IN_PATH="$(dirname "$(realpath "$0")")"

if [[ $VIRTUAL_ENV != "" ]]
then
  # Strip out the path and just leave the env name
  currentvenv="${VIRTUAL_ENV##*/}"
fi

if [[ "$currentvenv" != "$venv" ]]
then
  #workon $venv
  source ${IN_PATH}/.venv/bin/activate
#else
#  echo "Already on environment $venv"
fi
